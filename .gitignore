# Generated macOS app bundles and per-machine runtime configuration.
dist/
boujoy-config.json
*.dSYM/

# Local runtimes, vaults, state, caches, and credentials never belong in the
# public source repository.
runtime/
vault/
.env
.env.*
!.env.example
*.pem
*.p12
*.mobileprovision
*.key
*.sqlite
*.sqlite3
*.db
*.jsonl

# Tooling and macOS noise.
__pycache__/
*.py[cod]
.pytest_cache/
coverage/
.DS_Store
__MACOSX/
*.log

# Agnx 子应用胶水产物必须入库（上游裸 dist 规则会误伤 .agnx/dist）
!.agnx/dist/
!.agnx/dist/**
