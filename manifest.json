{
  "id": "boujoy-harness",
  "name": "Boujoy 工作台",
  "version": "0.2.21",
  "engines": {
    "agnx": ">=1.0.0"
  },
  "main": "./.agnx/dist/index.js",
  "icon": "./assets/boujoy-b-icon.svg",
  "sidecar": {
    "supervised": true,
    "ensureTool": "tools/ensure-boujoy-gateway.mjs",
    "stateFile": "boujoy-gateway.json",
    "defaultPort": 8766
  },
  "guest": {
    "kind": "web",
    "auth": "none",
    "preferStrategy": "auto"
  },
  "contributes": {
    "commands": [
      {
        "id": "boujoy-harness.open",
        "title": "Boujoy 工作台"
      }
    ],
    "panels": [
      {
        "id": "boujoy-harness.main",
        "title": "Boujoy 工作台"
      }
    ]
  }
}
